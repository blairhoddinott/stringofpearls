{
  "name": "stringofpearls",
  "version": "6.29.0-BETA",
  "description": "An ATC simulator in HTML5",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "node tools/build.js --production",
    "build:dev": "node tools/build.js",
    "build:test": "node tools/build.test.js",
    "browser:smoke": "tools/browser-smoke/run.sh",
    "coveralls": "nyc report -r text-lcov | coveralls",
    "docker:smoke": "tools/docker/smoke-test.sh",
    "lint": "eslint src/assets/scripts/client/**",
    "report": "nyc report --reporter=cobertura --reporter=lcov",
    "server": "npm run start",
    "start": "node public/assets/scripts/server/index.js",
    "test": "ava --concurrency=5",
    "test:coverage:legacy": "nyc ava --concurrency=5",
    "validator": "npm run validate:assets",
    "validator:test": "node tools/validate-assets.test.js",
    "validate:assets": "node tools/validate-assets.js",
    "watch": "node tools/build.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blairhoddinott/stringofpearls.git"
  },
  "keywords": [
    "atc",
    "html5",
    "canvas",
    "javascript",
    "game",
    "simulator",
    "air traffic control",
    "airline",
    "aviation",
    "airplane"
  ],
  "author": "Jon Ross <jonrosszlsa@gmail.com> (http://zlsa.github.io/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/blairhoddinott/stringofpearls/issues"
  },
  "homepage": "https://github.com/blairhoddinott/stringofpearls",
  "ava": {
    "files": [
      "test/**/*.spec.js"
    ],
    "sources": [
      "!**/_mocks/**",
      "!**/fixtures/**",
      "!**/testHelpers/**"
    ],
    "verbose": true,
    "require": [
      "@babel/register",
      "./test/testHelpers/globalProps.js",
      "./test/testHelpers/localStorage.js",
      "./test/testHelpers/setupBrowserEnv.js"
    ]
  },
  "nyc": {
    "all": false,
    "include": [
      "src/assets/scripts/**/*.js",
      "!src/assets/scripts/client/constants/**/*.js",
      "!**/_mocks/**",
      "!**/fixtures/**",
      "!**/testHelpers/**",
      "!**/public/**"
    ]
  },
  "dependencies": {
    "ansi-colors": "3.2.4",
    "express": "4.16.4",
    "handlebars": "4.1.2",
    "jquery": "3.5.0",
    "lodash": "4.17.21",
    "raf": "3.4.1"
  },
  "devDependencies": {
    "@babel/core": "7.4.4",
    "@babel/plugin-proposal-class-properties": "7.4.4",
    "@babel/plugin-proposal-json-strings": "7.2.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.12.1",
    "@babel/plugin-proposal-object-rest-spread": "7.4.4",
    "@babel/plugin-proposal-optional-chaining": "7.2.0",
    "@babel/plugin-syntax-dynamic-import": "7.2.0",
    "@babel/plugin-syntax-import-meta": "7.2.0",
    "@babel/preset-env": "7.4.4",
    "@babel/preset-react": "7.0.0",
    "@babel/register": "7.4.4",
    "autoprefixer": "10.6.0",
    "ava": "1.4.1",
    "babel-eslint": "10.0.1",
    "browser-env": "3.3.0",
    "clean-css": "5.3.3",
    "coveralls": "3.0.3",
    "eslint": "5.16.0",
    "eslint-config-airbnb": "17.1.0",
    "eslint-plugin-import": "2.17.2",
    "eslint-plugin-jsx-a11y": "6.2.1",
    "eslint-plugin-react": "7.12.4",
    "esbuild": "0.28.2",
    "handlebars-layouts": "3.1.4",
    "less": "4.9.1",
    "nyc": "14.1.0",
    "postcss": "8.5.8",
    "showdown": "1.9.1",
    "sinon": "7.3.2",
    "source-map": "0.5.7"
  }
}
