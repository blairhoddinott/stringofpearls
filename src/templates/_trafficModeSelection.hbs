<section
    id="traffic-mode-selection"
    class="traffic-mode-selection notSelectable"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="traffic-mode-selection-title"
>
    <div class="traffic-mode-selection-panel">
        <h1 id="traffic-mode-selection-title" class="traffic-mode-selection-title">Choose your position</h1>
        <p class="traffic-mode-selection-intro">Which traffic do you want to work?</p>
        <div class="traffic-mode-selection-options">
            <button class="traffic-mode-selection-option mix-traffic-mode-selection-option_arrivals" type="button" data-traffic-mode="arrivals">Arrivals</button>
            <button class="traffic-mode-selection-option mix-traffic-mode-selection-option_departures" type="button" data-traffic-mode="departures">Departures</button>
            <button class="traffic-mode-selection-option mix-traffic-mode-selection-option_both" type="button" data-traffic-mode="both">Both</button>
        </div>
        <p class="traffic-mode-selection-note">Your choice applies until you reload the simulator.</p>
    </div>
</section>
